# Contract deployment settings. Copy to contracts/.env (git-ignored). Never commit real values.

# Polygon Amoy RPC (Alchemy: dashboard.alchemy.com, create an app on Polygon Amoy, copy the HTTPS URL)
AMOY_RPC_URL=
# Sepolia, only if you deploy there
# SEPOLIA_RPC_URL=

# A THROWAWAY account funded with test POL from faucet.polygon.technology. Never a wallet that holds anything valuable.
DEPLOYER_PRIVATE_KEY=

# Publishes the source on Polygonscan (polygonscan.com/myapikey). Needed by `npm run verify:amoy`.
POLYGONSCAN_API_KEY=

# Identity verifier: test (default, accepts only Anon Aadhaar's published test QR codes) or real.
# ANON_AADHAAR_MODE=test
