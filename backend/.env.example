# Backend settings. Locally: copy to backend/.env (git-ignored; `npm run backend:dev` loads it).
# On Render: enter these in the service's Environment tab instead (see ../render.yaml and ../DEPLOY.md). Never commit real values.

# --- Core ---------------------------------------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# 1 only on your own machine: relaxes the cookie, returns invite links in API responses. MUST be 0 when deployed.
DJANGO_DEBUG=1
BACKEND_PORT=8000
# Hosts the API answers to, comma-separated. Render's own hostname is always allowed.
# DJANGO_ALLOWED_HOSTS=
# Reverse proxies in front of the API (Vercel rewrite + Render load balancer = 2), so rate limits see the real client IP.
# NUM_PROXIES=2

# --- Web app origin (CORS, sign-in, links in emails) ---------------------------------------------------
FRONTEND_URL=http://localhost:3000
# ALLOWED_ORIGINS=https://your-project.vercel.app
# SIWE_ALLOWED_DOMAINS=your-project.vercel.app
SIWE_CHAIN_IDS=31337,80002
# CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app

# --- Database: Neon connection string (pooled), e.g. postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Leave empty to use a local SQLite file.
DATABASE_URL=

# --- Scheduler ------------------------------------------------------------------------------------------
# POST /internal/tick must carry this value in the X-Tick-Secret header. Empty disables the endpoint (503).
# openssl rand -hex 32     (or: python -c "import secrets; print(secrets.token_hex(32))")
TICK_SECRET=
# TICK_BUDGET_SECONDS=24

# --- Email: Resend HTTP API ----------------------------------------------------------------------------
RESEND_API_KEY=
# "Heirloom <onboarding@resend.dev>" only reaches your own Resend account address. Use a verified domain to email anyone.
# DEFAULT_FROM_EMAIL=Heirloom <onboarding@resend.dev>
# Print mail to the log instead of sending (local development):
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Blockchain -----------------------------------------------------------------------------------------
# The addresses and ABI come from chain/deployments.json (public networks, committed) and chain/deployments.local.json (local chain).
# Only watch these chain ids (empty = all deployed): ACTIVE_CHAIN_IDS=80002
RPC_URL_31337=http://127.0.0.1:8545
# RPC_URL_80002=https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY
# Alchemy's free plan limits eth_getLogs to 10 blocks. Send log queries to a public node, in chunks it allows:
# LOGS_RPC_URL_80002=https://polygon-amoy-bor-rpc.publicnode.com
# INDEX_CHUNK_BLOCKS_80002=1000
# Blocks an event must be buried under before it is indexed: CONFIRMATIONS_80002=30

# --- Claim alerts ---------------------------------------------------------------------------------------
# SMS is off unless SMS_ENABLED=true and the three Twilio values are set. The owner's email alert needs no SMS.
SMS_ENABLED=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15551234567
# ALERT_SMS_AFTER_SECONDS=259200
# ALERT_GUARDIAN_BEFORE_END_SECONDS=86400
