# Copy to .env (never commit it). Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# 1 for local development: relaxes cookie Secure/HTTPS-redirect and returns invite links in API responses.
# Must be 0 in any shared or production environment.
DJANGO_DEBUG=1

FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
SIWE_ALLOWED_DOMAINS=localhost:3000
SIWE_CHAIN_IDS=31337,11155111,80002

# Number of reverse proxies in front of the API (so rate limits use the real client IP).
NUM_PROXIES=0

# Email. The console backend prints invite emails to the server log.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=Heirloom <no-reply@your-domain>

# Host port for the API (change if 8000 is taken)
BACKEND_PORT=8000

# --- Blockchain indexer (Celery worker + beat) ---------------------------------------------------------
# The ABI and deployed addresses come from backend/chain/, written by contracts/scripts/deploy.js.
# From inside Docker, a node on your machine is reached via host.docker.internal; start it with HARDHAT_HOST=0.0.0.0.
# RPC_URL_31337=http://host.docker.internal:8545
# RPC_URL_11155111=https://ethereum-sepolia-rpc.publicnode.com
# RPC_URL_80002=https://rpc-amoy.polygon.technology
# Blocks an event must be buried under before it is indexed and anyone is emailed about it.
# CONFIRMATIONS_31337=0
# CONFIRMATIONS_11155111=4
# CONFIRMATIONS_80002=30
# INDEX_INTERVAL_SECONDS=15
# REMINDER_INTERVAL_SECONDS=300
