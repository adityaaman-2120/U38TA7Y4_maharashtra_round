# Server-side only. Never prefix with NEXT_PUBLIC_.
PINATA_JWT=
# Django API the Next server proxies /backend/* to
BACKEND_URL=http://127.0.0.1:8000

# Optional overrides (defaults shown)
# PINATA_API_URL=https://api.pinata.cloud

# Public
# Dedicated gateway recommended, e.g. https://<name>.mypinata.cloud/ipfs
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
NEXT_PUBLIC_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# --- Zero-knowledge identity (Anon Aadhaar) ---
# Which Aadhaar QR codes the SDK accepts. Must match what the deployed verifier trusts (defaults to the deployment's mode).
# NEXT_PUBLIC_ANON_AADHAAR_MODE=test
# Local test double for the prover; only works against a locally deployed mock verifier. Never set in production.
# NEXT_PUBLIC_ZK_PROVER=mock
