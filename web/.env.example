# Web app settings. Locally: copy to web/.env.local (git-ignored). On Vercel: enter these in Project, Settings, Environment Variables.
# Variables starting NEXT_PUBLIC_ are baked into the browser bundle at build time and are visible to everyone: never put a secret in one.

# --- Server-only (never sent to the browser) ---------------------------------------------------------------
# The Django API's base URL. Locally http://127.0.0.1:8000; on Vercel the Render address. The browser only ever calls /backend/*.
BACKEND_URL=http://127.0.0.1:8000
# Pinata JWT (API Keys, New Key, pinFileToIPFS). Used only by /api/storage.
PINATA_JWT=
# RPC endpoints for the read-only relay at /api/rpc (used when NEXT_PUBLIC_RPC_PROXY=1). The provider key stays here.
# RPC_URL_80002=https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY
# LOGS_RPC_URL_80002=https://polygon-amoy-bor-rpc.publicnode.com

# --- Which deployment this site talks to (public; printed by `npm --prefix contracts run deploy:amoy`) --------
# Leave all of these unset for local development: the app then uses web/src/lib/contracts.ts and offers every network.
# NEXT_PUBLIC_CHAIN_ID=80002
# NEXT_PUBLIC_CONTRACT_ADDRESS=0x...
# NEXT_PUBLIC_CONTRACT_START_BLOCK=0
# NEXT_PUBLIC_ANON_AADHAAR_ADDRESS=0x...        (anonAadhaar in contracts/deployments/<network>.json)
# NEXT_PUBLIC_ANON_AADHAAR_MODE=test            (test: only Anon Aadhaar's published test QR codes verify)
# NEXT_PUBLIC_NULLIFIER_SEED=...                (nullifierSeed in contracts/deployments/<network>.json)
# NEXT_PUBLIC_TEST_TOKEN_ADDRESS=0x...          (optional faucet token, contracts/deployments/tokens/<network>.json)

# --- Reading the chain from the browser ----------------------------------------------------------------------
# 1 = go through this site's /api/rpc (the provider key stays on the server). Unset = talk to a public RPC directly.
# NEXT_PUBLIC_RPC_PROXY=1
# Blocks per eth_getLogs call when the Audit page falls back to the chain (match your RPC's limit; default 9000).
# NEXT_PUBLIC_LOG_CHUNK=1000

# --- Storage / identity ------------------------------------------------------------------------------------
# A dedicated Pinata gateway downloads faster than the public one: https://yourname.mypinata.cloud/ipfs
# NEXT_PUBLIC_IPFS_GATEWAY=
# Local development only: use the test double for identity proofs (never against a public network).
# NEXT_PUBLIC_ZK_PROVER=mock
